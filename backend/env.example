# Copie para backend/.env e ajuste se precisar
#
# Acesso pelo IP da rede (ex.: 192.168.x.x:8000): o servidor precisa ouvir em 0.0.0.0
#   run-dev.bat   ou:  uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload
# Só neste PC: --host 127.0.0.1
#
DERIV_APP_ID=1089
DERIV_WS_URL=wss://ws.derivws.com/websockets/v3
# true = Access-Control-Allow-Origin: * (padrão; ideal para dev). false = lista CORS_ORIGINS + credenciais.
CORS_ALLOW_ALL=true
CORS_ORIGINS=http://192.168.13.140:3000,http://127.0.0.1:3000
